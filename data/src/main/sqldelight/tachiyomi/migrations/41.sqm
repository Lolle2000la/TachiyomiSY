UPDATE mangas SET last_modified_at = strftime('%s', 'now') WHERE last_modified_at = 0;
UPDATE mangas SET favorite_modified_at = strftime('%s', 'now') WHERE favorite = 1 AND favorite_modified_at IS NULL;
UPDATE chapters SET last_modified_at = strftime('%s', 'now') WHERE last_modified_at = 0;

CREATE TRIGGER insert_manga_last_modified_at AFTER INSERT ON mangas
BEGIN
    UPDATE mangas
    SET last_modified_at = CASE WHEN last_modified_at = 0 THEN strftime('%s', 'now') ELSE last_modified_at END,
        favorite_modified_at = CASE WHEN favorite = 1 AND favorite_modified_at IS NULL THEN strftime('%s', 'now') ELSE favorite_modified_at END
    WHERE _id = new._id;
END;

CREATE TRIGGER insert_chapter_last_modified_at AFTER INSERT ON chapters
BEGIN
    UPDATE chapters
    SET last_modified_at = CASE WHEN last_modified_at = 0 THEN strftime('%s', 'now') ELSE last_modified_at END
    WHERE _id = new._id;
END;

ALTER TABLE mangas_categories DROP COLUMN last_modified_at;
DROP TRIGGER IF EXISTS update_last_modified_at_mangas_categories;
